# Default deny-list: this workspace contains many local exports, browser bundles,
# screenshots, query drafts, and temporary scripts that should not be synced.
*

# Git/project metadata
!.gitignore
!README.md

# Project knowledge YAML files
!/*.yaml
!/*.yml

# Portable Codex project skills
!.codex/
!.codex/**

# 倍特小时报：可复现的项目资料与明确导出的归档；运行中的文件仍在原路径。
!/projects/
!/projects/beite-hourly-report/
!/projects/beite-hourly-report/**
!/projects/auto-project/
!/projects/auto-project/**
!AGENTS.md

# Local Python execution caches are never project knowledge.
**/__pycache__/
*.pyc

# Repository navigation and offline maintenance; no production secrets.
!/catalog/
!/catalog/**
!/scripts/
!/scripts/repo-maintenance.py
!/scripts/test_repo_maintenance.py
!/.github/
!/.github/workflows/
!/.github/workflows/repository-checks.yml
!/docs/
!/docs/repository-maintenance.md
!/docs/optimization-impact-20261120.md
